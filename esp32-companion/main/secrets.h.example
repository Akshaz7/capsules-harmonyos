// Wi-Fi credentials. Copy this file to main/secrets.h (git-ignored) and fill it in.
//
// One { "SSID", "password" } pair per network, tried in this order: the board joins the
// first one it can see and falls back to the next. Use "" as the password for an open
// network. The ESP32-S3 radio is 2.4 GHz only.
#define WIFI_NETWORKS \
    { "Venue network", "password" }, \
    { "Phone hotspot", "password" }

// Cloud relay (see RELAY.md): where the board registers itself and polls for capsules.
// The planned backend is "https://harmoniser-web.vercel.app"; https:// is checked against
// ESP-IDF's certificate bundle. http:// is for mock_relay.py on the same network, e.g.
// "http://192.168.1.20:8090". Leave it empty, or leave the line out, and the board never
// talks to a relay: it then only serves its local HTTP API.
#define RELAY_URL ""
