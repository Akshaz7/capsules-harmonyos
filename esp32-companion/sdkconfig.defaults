# Board: Waveshare ESP32-S3-Touch-AMOLED-1.8 (ESP32-S3R8, 16 MB flash, 8 MB octal PSRAM).
# Flash/PSRAM/CPU settings follow Waveshare's 00_bsp_quickstart example.
# After changing this file: rm sdkconfig && idf.py build
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_FREERTOS_HZ=1000
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# The LVGL draw buffer ends up in PSRAM, so the SPI driver copies every flush into an
# internal DMA buffer of the same size. With Wi-Fi running, the largest free internal block
# is about 31 KB (measured), so the BSP's default of 100 lines (73.6 KB) fails with
# "spi transmit (queue) color failed" and the screen stays black. 20 lines = 14.7 KB.
CONFIG_BSP_DISPLAY_LVGL_BUF_HEIGHT=20
# Let Wi-Fi and lwIP take their buffers from PSRAM first, to keep internal RAM free.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# LVGL: no examples or demos (build time), dark theme, snapshot for GET /screenshot.
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
CONFIG_LV_THEME_DEFAULT_DARK=y
CONFIG_LV_USE_SNAPSHOT=y
