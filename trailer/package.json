{
  "name": "harmoniser-trailer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "manifest": "node scripts/footage-manifest.mjs",
    "audio": "node scripts/gen-audio.mjs",
    "studio": "npm run manifest && remotion studio",
    "preview": "npm run manifest && remotion render HarmoniserTrailer out/preview.mp4 --codec=h264 --scale=0.5",
    "render": "npm run manifest && remotion render HarmoniserTrailer out/harmoniser-trailer.mp4 --codec=h264 --crf=18",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "@remotion/google-fonts": "4.0.532",
    "@remotion/media": "4.0.532",
    "@remotion/media-utils": "4.0.532",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
